generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  Pria
  Wanita
}

model User {
  id        String    @id @default(uuid())
  name      String    @db.VarChar(100)
  email     String    @unique @db.VarChar(150)
  password  String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  orders    Order[]
  sessions  Session[]

  @@map("users")
}

/// Satu login = satu sesi. Access token membawa `sid`; logout me-revoke sesi
/// sehingga access token yang belum kedaluwarsa pun langsung ditolak.
model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  /// SHA-256 dari refresh token aktif (rotasi: berganti setiap refresh).
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Product {
  id          Int         @id @default(autoincrement())
  productCode String      @unique @map("product_code") @db.VarChar(20)
  productName String      @map("product_name") @db.VarChar(150)
  imageUrl    String?     @map("image_url") @db.VarChar(500)
  stock       Int
  price       Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")
  orderItems  OrderItem[]

  @@index([productName])
  @@map("products")
}

model Customer {
  id              String    @id @default(uuid())
  customerName    String    @map("customer_name") @db.VarChar(150)
  customerAddress String    @map("customer_address") @db.VarChar(255)
  gender          Gender
  birthDate       DateTime  @map("birth_date") @db.Date
  phone           String?   @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  orders          Order[]

  @@index([customerName])
  @@map("customers")
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique @map("order_number") @db.VarChar(30)
  customerId  String      @map("customer_id")
  createdBy   String      @map("created_by")
  orderDate   DateTime    @default(now()) @map("order_date")
  totalAmount Decimal     @map("total_amount") @db.Decimal(14, 2)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  customer    Customer    @relation(fields: [customerId], references: [id])
  user        User        @relation(fields: [createdBy], references: [id])
  items       OrderItem[]

  @@index([orderDate])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  productId Int      @map("product_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderCounter {
  date    String @id @db.VarChar(8)
  lastSeq Int    @default(0) @map("last_seq")

  @@map("order_counters")
}
