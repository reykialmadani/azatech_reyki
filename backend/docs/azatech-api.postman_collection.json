{
  "info": {
    "name": "Azatech Online Shop API",
    "description": "REST API Order Management (NestJS). Jalankan \"Auth / Login\" lebih dulu: token otomatis disimpan ke variabel collection.\n\nResponse sukses: `{ success, message, data, meta? }` · error: `{ success: false, message, errors? }`.\nSpesifikasi lengkap: Swagger UI di `/api/docs` atau `backend/docs/openapi.json`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "product_id",
      "value": "1"
    },
    {
      "key": "customer_id",
      "value": ""
    },
    {
      "key": "order_customer_id",
      "value": ""
    },
    {
      "key": "order_id",
      "value": "1"
    }
  ],
