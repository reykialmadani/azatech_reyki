          {
            "name": "sort",
            "required": true,
            "in": "query",
            "description": "Format `<field>:<asc|desc>`.",
            "schema": {
              "default": "product_name:asc",
              "example": "price:desc",
              "type": "string",
              "enum": [
                "product_name:asc",
                "product_name:desc",
                "price:asc",
                "price:desc",
                "stock:asc",
                "stock:desc"
              ]
            }
          },
          {
            "name": "page",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "per_page",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List produk aktif (pagination, search nama/kode, sort)",
        "tags": [
          "Products"
