  "info": {
    "title": "Azatech Online Shop API",
    "description": "REST API Order Management. Semua endpoint selain login/refresh membutuhkan Bearer token. Response sukses: `{ success, message, data, meta? }`; error: `{ success: false, message, errors? }`.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@azatech.id",
            "maxLength": 150,
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "Admin123!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string",
            "description": "Refresh token dari response login / refresh sebelumnya."
          }
        },
        "required": [
          "refresh_token"
        ]
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "product_code": {
            "type": "string",
            "description": "Unik, disimpan uppercase.",
            "example": "P0001",
            "maxLength": 20,
            "pattern": "^[A-Z0-9-]+$"
          },
          "product_name": {
            "type": "string",
            "maxLength": 150
          },
          "image_url": {
            "type": "string",
            "nullable": true,
            "description": "URL gambar opsional (http/https).",
            "example": "https://images.unsplash.com/photo-1",
            "maxLength": 500,
            "format": "uri"
          },
          "price": {
            "type": "number",
            "description": "Harga satuan, > 0, maksimal 2 desimal.",
            "example": 12000,
            "maximum": 9999999999.99,
            "minimum": 1
          },
          "stock": {
            "type": "number",
            "example": 10,
            "minimum": 0,
            "maximum": 2147483647
          }
        },
        "required": [
          "product_code",
          "product_name",
          "price",
          "stock"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "product_code": {
            "type": "string",
            "description": "Unik, disimpan uppercase.",
            "example": "P0001",
            "maxLength": 20,
            "pattern": "^[A-Z0-9-]+$"
          },
          "product_name": {
            "type": "string",
            "maxLength": 150
          },
          "image_url": {
            "type": "string",
            "nullable": true,
            "description": "URL gambar opsional (http/https).",
            "example": "https://images.unsplash.com/photo-1",
            "maxLength": 500,
            "format": "uri"
          },
          "price": {
            "type": "number",
            "description": "Harga satuan, > 0, maksimal 2 desimal.",
            "example": 12000,
            "maximum": 9999999999.99,
            "minimum": 1
          },
          "stock": {
            "type": "number",
            "example": 10,
            "minimum": 0,
            "maximum": 2147483647
          }
        },
        "required": [
          "product_code",
          "product_name",
          "price",
          "stock"
        ]
      },
      "CreateCustomerDto": {
        "type": "object",
        "properties": {
          "customer_name": {
            "type": "string",
            "maxLength": 150
          },
          "customer_address": {
            "type": "string",
            "maxLength": 255
          },
          "gender": {
            "type": "string",
            "example": "Pria",
            "enum": [
              "Pria",
              "Wanita"
            ]
          },
          "birth_date": {
            "type": "string",
            "description": "Format YYYY-MM-DD, tidak boleh di masa depan.",
            "example": "1995-02-10"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "description": "Opsional; string kosong disimpan sebagai null.",
            "example": "081234567890",
            "maxLength": 20,
            "pattern": "^(\\+62|62|0)8\\d{7,12}$"
          }
        },
        "required": [
          "customer_name",
          "customer_address",
          "gender",
          "birth_date"
        ]
      },
      "UpdateCustomerDto": {
        "type": "object",
        "properties": {
          "customer_name": {
            "type": "string",
            "maxLength": 150
          },
          "customer_address": {
            "type": "string",
            "maxLength": 255
          },
          "gender": {
            "example": "Pria",
            "enum": [
              "Pria",
              "Wanita"
            ],
            "type": "string"
          },
          "birth_date": {
            "type": "string",
            "description": "Format YYYY-MM-DD, tidak boleh di masa depan.",
            "example": "1995-02-10"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "description": "Opsional; string kosong disimpan sebagai null.",
            "example": "081234567890",
            "maxLength": 20,
            "pattern": "^(\\+62|62|0)8\\d{7,12}$"
          }
        },
        "required": [
          "customer_name",
          "customer_address",
          "gender",
          "birth_date"
        ]
      },
      "OrderItemDto": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "number",
            "example": 1,
            "minimum": 1,
            "maximum": 2147483647
          },
          "quantity": {
            "type": "number",
            "example": 2,
            "minimum": 1,
            "maximum": 1000000
          }
        },
        "required": [
          "product_id",
          "quantity"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "example": "9d2f6c1e-1a2b-4c3d-8e9f-0a1b2c3d4e5f",
            "format": "uuid"
          },
          "items": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemDto"
            }
          }
        },
        "required": [
          "customer_id",
          "items"
        ]
      }
    }
  }
}