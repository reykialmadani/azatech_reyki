            "bearer": []
          }
        ],
        "summary": "Riwayat order (filter from/to WIB inklusif, customer_id)",
        "tags": [
          "Orders"
        ]
      },
      "post": {
        "description": "Harga & total dihitung server. 409 jika stok kurang (errors[\"items.N.quantity\"]), 422 jika input / produk / pelanggan tidak valid. Gagal satu item = seluruh order batal.",
        "operationId": "OrdersController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
