# Variabel untuk docker-compose.yml (root). Salin: cp .env.example .env

# --- Database ---
POSTGRES_USER=azatech
POSTGRES_PASSWORD=azatech
POSTGRES_DB=azatech_shop
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000
# Ganti dengan string acak panjang (min. 16 karakter), mis. hasil: openssl rand -hex 32
JWT_ACCESS_SECRET=ganti-dengan-string-acak-panjang-untuk-access
JWT_REFRESH_SECRET=ganti-dengan-string-acak-panjang-untuk-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# true = seeder dijalankan saat container start (idempoten, aman diulang)
RUN_SEED=true
SEED_ADMIN_EMAIL=admin@azatech.id
SEED_ADMIN_PASSWORD=Admin123!

# --- Frontend ---
FRONTEND_PORT=3000
# Alamat API yang dipanggil BROWSER (dibakukan saat build image frontend)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
